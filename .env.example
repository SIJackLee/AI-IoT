# Copy to .env and fill in local values. Do not commit .env.

# Wi-Fi (ESP32 STA) — firmware uses firmware/include/secrets.h
WIFI_SSID=
WIFI_PASSWORD=

# Firebase Realtime Database
FIREBASE_HOST=
FIREBASE_AUTH=
DEVICE_ID=aiot01

# MQTT (optional / later edge broker)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartfarm/

# Optional API keys (leave empty if unused)
OPENAI_API_KEY=
